{
  "name": "payx-js",
  "version": "1.0.1",
  "description": "The official Browser SDK for PayX Popup Payments",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs,iife --global-name PayX --watch --dts",
    "build": "tsup src/index.ts --format esm,cjs,iife --global-name PayX --dts --minify",
    "test": "vitest run"
  },
  "keywords": [
    "payx",
    "payments",
    "ghana",
    "mobile-money",
    "popup"
  ],
  "author": "PayX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roger9696/payx-js.git"
  },
  "bugs": {
    "url": "https://github.com/roger9696/payx-js/issues"
  },
  "homepage": "https://github.com/roger9696/payx-js#readme",
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
